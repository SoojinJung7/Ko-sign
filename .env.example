# ---- Core ----
# Neon Postgres (works locally and on Vercel). Create a free DB at https://neon.tech
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Public base URL of the app
APP_URL="http://localhost:3000"
# Secret for iron-session cookie encryption (>= 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Storage (Vercel Blob) ----
# Optional in dev: without it, PDFs are stored on local disk under .blob-store/
BLOB_READ_WRITE_TOKEN=""

# ---- Email (Resend) ----
# Optional in dev: without it, emails + links are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Ko-sign <no-reply@ko-sign.app>"

# ---- SMS / OTP (Twilio) ----
# Optional in dev: without it, OTP codes are printed to console and code 000000 always works.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
